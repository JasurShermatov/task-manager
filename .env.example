# ================= Postgres =================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# host porti (mahalliy postgres bilan urishmasligi uchun 5433)
POSTGRES_PORT=

# ================= Host portlari =================
API_PORT=
WEB_PORT=

# ================= Backend =================
JWT_SECRET=chm
# bot -> API xizmat tokeni
SERVICE_TOKEN=
# foto/hujjat havolalari imzosi
FILE_SIGNING_SECRET=change_me_file_secret
# faqat birinchi ishga tushishda yaratiladi - keyin UI dan almashtiring
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin_pass
# parol uchun eng kam belgi soni
MIN_PASSWORD_LEN=4
TZ_NAME=Asia/Tashkent
# imzolangan fayl havolalari shu manzil bilan quriladi (nginx orqali)
PUBLIC_API_URL=http://localhost:3000/api

# ================= Telegram bot =================
BOT_TOKEN=
# bot manzili (@ siz). Bot ishga tushganda o'zi to'ldiradi, superadmin keyin o'zgartira oladi
BOT_USERNAME=
# polling | webhook
BOT_MODE=polling
# webhook rejimida: https://your-domain/telegram/webhook
WEBHOOK_URL=
WEBHOOK_SECRET=change_me_webhook_secret
# botdagi "Web'da ochish" tugmasi uchun
WEB_URL=http://localhost:3000

# ================= Ovoz -> matn (ixtiyoriy) =================
# bo'sh qoldirilsa: ovozli/matnli vazifa berish o'chadi, qolgan hammasi ishlaydi
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_LLM_MODEL=gpt-4o-mini
