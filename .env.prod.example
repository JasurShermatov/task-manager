# ============================================================================
#  SAFF Vazifalar nazorati — PRODUCTION sozlamalari
#  Serverda:  cp .env.prod.example .env   va pastdagi qiymatlarni to'ldiring.
#  Bu fayl git'ga tushmaydi (.gitignore da).
# ============================================================================

# ---------- 1) Manzil ----------
# Hozircha serverning IP si. Domen ulanganda: https://saff.uz
PUBLIC_URL=http://123.45.67.89

# ---------- 2) Baza ----------
POSTGRES_DB=saff_tasks
POSTGRES_USER=saff
# Kuchli parol qo'ying:  openssl rand -hex 24
POSTGRES_PASSWORD=BU_YERGA_KUCHLI_PAROL

# ---------- 3) Maxfiy kalitlar ----------
# Har birini alohida yarating:  openssl rand -hex 32
JWT_SECRET=BU_YERGA_TASODIFIY_KALIT
SERVICE_TOKEN=BU_YERGA_TASODIFIY_KALIT
FILE_SIGNING_SECRET=BU_YERGA_TASODIFIY_KALIT
WEBHOOK_SECRET=BU_YERGA_TASODIFIY_KALIT

# ---------- 4) Birinchi admin ----------
# Faqat birinchi ishga tushishda yaratiladi. Kirgach parolni Profil'dan almashtiring.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=BU_YERGA_ADMIN_PAROLI

# ---------- 5) Telegram bot ----------
# @BotFather bergan token
BOT_TOKEN=
# Bot manzili (@ siz). Bo'sh qoldirsangiz bot ishga tushganda o'zi to'ldiradi.
BOT_USERNAME=
BOT_MODE=polling
WEBHOOK_URL=

# ---------- 6) Ovoz bilan vazifa berish (ixtiyoriy) ----------
# Bo'sh qoldirilsa faqat ovozli buyruq o'chadi, qolgan hammasi ishlayveradi.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_LLM_MODEL=gpt-4o-mini

# ---------- 7) Boshqa ----------
MIN_PASSWORD_LEN=4
TZ_NAME=Asia/Tashkent
